// The sensor_msgs/msg/Image message type included by default with ROS 2

#include "Header.idl"

module sensor_msgs
{
	module msg
	{
		struct Image
		{
			std_msgs::msg::Header header;
			uint32 height;
			uint32 width;
			string encoding;
			uint8 is_bigendian;
			uint32 step;
			sequence<uint8> data;
		};
	};
};
