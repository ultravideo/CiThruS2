// The geometry_msgs/msg/Quaternion message type included by default with ROS 2

module geometry_msgs
{
	module msg
	{
		struct Quaternion
		{
			@default (value=0.0)
			double x;

			@default (value=0.0)
			double y;

			@default (value=0.0)
			double z;

			@default (value=1.0)
			double w;
		};
	};
};
